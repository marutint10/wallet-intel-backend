{
  "name": "wallet-intel-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:migrate:chains": "node scripts/run-sql-migration.js migrations/202605030001_add_chain_id_to_wallet_tables.sql",
    "db:migrate:token": "psql $DATABASE_URL -f migrations/202605060001_create_token_tables.sql",
    "start": "nest start",
    "prestart:dev": "node scripts/free-port.js",
    "start:dev": "nest start --watch",
    "db:migrate:whitelist": "node scripts/run-sql-migration.js migrations/202605250001_create_whitelisted_wallets.sql",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "whitelist:sync": "ts-node -p tsconfig.scripts.json -r tsconfig-paths/register scripts/sync-whitelist.ts",
    "start:prod": "node dist/main",
    "token:replay-aggregation": "npm run build && node scripts/replay-token-aggregation.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.9.0",
    "cache-manager": "^7.2.8",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "ethers": "^6.13.5",
    "iron-session": "^8.0.4",
    "p-limit": "^3.1.0",
    "pg": "^8.13.3",
    "playwright": "^1.60.0",
    "puppeteer": "^24.43.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "siwe": "^3.0.0",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "next": "^16.2.6",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
