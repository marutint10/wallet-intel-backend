MORALIS_API_KEY=your_key_here
CHAINBASE_API_KEY=your_key_here
ETHERSCAN_API_KEY=your_key_here
# CoinGecko API key - get from https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Tavily web search API - get free key at https://tavily.com
TAVILY_API_KEY=
# Local Postgres example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_intel
# Hosted Postgres example:
# DATABASE_URL=postgresql://postgres:[password]@[pooler-host]:6543/postgres?sslmode=require
# DATABASE_SSL=true
DATABASE_CONNECTION_TIMEOUT_MS=10000
PORT=3000

# SIWE session (32+ characters; used by iron-session)
SESSION_SECRET=replace_with_32_plus_character_random_string_here

# PDF export (Puppeteer) — frontend print route + shared secret
FRONTEND_URL=http://localhost:5173
INTERNAL_PRINT_SECRET=change-me-to-a-long-random-string